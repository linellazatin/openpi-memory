  "description": "Global persistent memory for pi coding agent sessions via MEMORY.md injection",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/linellazatin/openpi-memory.git"
  },
